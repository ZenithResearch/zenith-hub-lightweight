  "snapshotPolicy": "Current selectedUnits establish complete named-subject membership (including untyped subjects), RDFC-1.0 integrity and one compatible RDF unit version. Binding-only object revisions can change independently without changing the unit revision. Historical versions are self-validated using their pinned mappings and never silently satisfy current references.",
  "semanticLinkPolicy": "RDF owns declared software, host, source/build, installation and configuration associations. Profile values are validated projections of those edges; paths, credentials, model bindings and undeclared structured attributes keep explicit profile/implementation owners.",
  "installationProvenancePolicy": "Source/build references on installation descriptions and source provenance on builds are exact object-version bindings. Source repository+commit, build content+source pin+platform, and installation provenance cannot change under an established identity. Descriptive metadata and same-copy location bindings may be revised. Unknown provenance is omitted; upgrades allocate a new installation description.",
  "storageMetadataOwners": {
    "StoredObjectRecord": "object-repository",
    "ObjectSelection": "object-repository snapshot reader",
    "AtomicUnitVersion": "object-repository commit ledger",
    "RdfUnitRecord": "object-repository RDF unit ledger",
    "ReferenceBinding": "application-reference-registry",
    "MappingRef": "trusted definition-set registry",
    "InspectionWrite": "server inspection facade supplies issued proof; HubRepository publishes evidence and optional registration association in one transaction"
  },
  "id": "urn:zenith:hub:field-ownership:v1",
  "referenceBindingOwner": "application-reference-registry; ownerKind + ownerRef + ownerRevision + field + targetRef; selector is current, exact object-version, or explicitly unresolved external; purpose determines action eligibility"
}
