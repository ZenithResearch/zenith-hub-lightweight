{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:zenith:hub:object-bundle:1",
  "type": "object",
  "properties": {
    "schema": {
      "const": "zenith.hub-object-bundle.v1"
    },
    "dataset": {
      "type": [
        "object",
        "array"
      ]
    },
    "datasetDigest": {
      "type": "object",
      "properties": {
        "algorithm": {
          "const": "RDFC-1.0"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "algorithm",
        "sha256"
      ],
      "additionalProperties": false
    },
    "requirements": {
      "type": "object",
      "properties": {
        "modules": {
          "type": "array",
          "maxItems": 2048,
          "items": {
            "type": "object",
            "properties": {
              "ontologyId": {
                "type": "string",
                "format": "uri"
              },
              "versionIri": {
                "type": "string",
                "format": "uri"
              },
              "version": {
                "type": "string"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            },
            "required": [
              "ontologyId",
              "versionIri",
              "version",
              "sha256"
            ],
            "additionalProperties": false
          }
        },
        "packages": {
          "type": "array",
          "maxItems": 2048,
          "items": {
            "type": "object",
            "properties": {
              "ontologyId": {
                "type": "string",
                "format": "uri"
              },
              "version": {
                "type": "string"
              },
              "manifestSha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            },
            "required": [
              "ontologyId",
              "version",
              "manifestSha256"
            ],
            "additionalProperties": false
          }
        },
        "schemas": {
          "type": "array",
          "maxItems": 2048,
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "format": "uri"
              },
              "documentSha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "profileSha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            },
            "required": [
              "id",
              "documentSha256",
              "profileSha256"
            ],
            "additionalProperties": false
          }
        },
        "resources": {
          "type": "array",
          "maxItems": 2048,
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "format": "uri"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            },
            "required": [
              "id",
              "sha256"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "modules",
        "packages",
        "schemas",
        "resources"
      ],
      "additionalProperties": false
    },
    "projections": {
      "type": "object",
      "maxProperties": 1000,
      "propertyNames": {
        "type": "string",
        "format": "uri"
      },
      "additionalProperties": {
        "type": "array",
        "maxItems": 64,
        "items": {
          "type": "object",
          "properties": {
            "profile": {
              "type": "string",
              "format": "uri"
            },
            "value": {}
          },
          "required": [
            "profile",
            "value"
          ],
          "additionalProperties": false
        }
      }
    },
    "admissions": {
      "type": "object",
      "maxProperties": 1000,
      "propertyNames": {
        "type": "string",
        "format": "uri"
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "integrity": {
      "type": "object",
      "properties": {
        "algorithm": {
          "const": "sha256-stable-json-v1"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "algorithm",
        "sha256"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema",
    "dataset",
    "datasetDigest",
    "requirements",
    "projections",
    "admissions",
    "integrity"
  ],
  "additionalProperties": false
}
