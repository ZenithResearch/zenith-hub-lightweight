# Copy to .env.operator.local (ignored by Git). Use absolute paths, without ~.
# Defaults target this Mac's existing owner-private installation.
# ZENITH_PROCESS_ROOT="/absolute/path/to/Zenith/Process"
# Supply a reviewed, extracted offline bundle only for a NEW installation.
# ZENITH_PROCESS_BUNDLE="/absolute/path/to/Zenith-Process-Mac"
ZENITH_PROCESS_PYTHON=/opt/homebrew/bin/python3.12
ZENITH_OPERATOR_PORT=4208
ZENITH_RUNTIME_PORT=8092
ZENITH_SERVICE_PORT=8091
