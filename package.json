{
  "name": "zenith-hub-lightweight",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/hub.mjs serve --dev",
    "build": "next build",
    "start": "node scripts/hub.mjs serve --production",
    "typecheck": "tsc --noEmit",
    "operator": "node scripts/hub.mjs serve",
    "test:deployer": "node --test tests/deployer/*.test.mjs",
    "operator:start": "node scripts/hub.mjs serve --production",
    "check:source": "node scripts/check-source.mjs",
    "test:objects": "node --test tests/objects/*.test.mjs",
    "test:setup": "node --test tests/setup/*.test.mjs",
    "test:hub": "node --test tests/hub/*.test.mjs",
    "hub": "node scripts/hub.mjs",
    "test:application": "node --test tests/application/*.test.mjs",
    "catalog:check": "node scripts/catalog-content.mjs",
    "catalog:generate": "node scripts/catalog-content.mjs --write",
    "test:catalog": "node --test tests/catalog/*.test.mjs"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "jsonld": "9.0.0",
    "next": "16.4.6",
    "rdf-canonize": "5.0.0",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@types/node": "24.12.2",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "typescript": "6.0.2"
  },
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/ZenithResearch/zenith-hub-lightweight.git"
  }
}
